# ===== 应用 =====
APP_NAME=TeamHub
APP_ENV=local
DEBUG=true
API_PREFIX=/api/v1

# ===== 数据库 =====
# 生产：PostgreSQL（会自动改写为 postgresql+asyncpg://）
DATABASE_URL=postgresql://teamhub:teamhub@127.0.0.1:5432/teamhub
# 本地零依赖降级（默认值）：SQLite 内存库 + StaticPool，跑测试用
# DATABASE_URL=sqlite+pysqlite:///:memory:
DB_ECHO=false

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6379/0
USE_FAKEREDIS=false

# ===== 认证 =====
# 生产必须替换：openssl rand -hex 32（至少 32 字节，RFC 7518 §3.2）
JWT_SECRET=dev-only-insecure-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ===== 限流（按租户配额）=====
RATE_LIMIT_PER_MINUTE=600

# ===== Celery =====
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_ALWAYS_EAGER=false
